# PostgreSQL connection string used by the app, Prisma CLI and sync workers.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/widsp"

# Separate database used by integration tests (tests/integration). Optional;
# integration tests are skipped when unset. It is reset by the test run.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/widsp_test"

# Public base URL, used for canonical URLs and metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
